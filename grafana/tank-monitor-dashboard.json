        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time, value FROM \"°F\"\nWHERE entity_id = 'tank_monitor_temperature_swing_1h' AND $__timeFilter(time)\nORDER BY time",
          "query": "SELECT time, value FROM \"°F\"\nWHERE entity_id = 'tank_monitor_temperature_swing_1h' AND $__timeFilter(time)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
