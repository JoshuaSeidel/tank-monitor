# Shared across every ESPHome device -- the Home Assistant add-on uses one
# secrets.yaml for all of them.
wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"
mqtt_broker: "192.168.1.10"

# Device-specific. Prefixed so they cannot collide with another device's
# keys in that shared file, and so this device can have its own MQTT user
# -- worth doing for access control and for telling devices apart in the
# broker log.
tank_monitor_mqtt_username: "tank-monitor"
tank_monitor_mqtt_password: "change-me"
tank_monitor_ota_password: "change-me"
tank_monitor_ap_password: "tankmonitor"

# Your Olson timezone, e.g. America/New_York
timezone: "America/New_York"

# Shared key for the ESP-NOW link between the controller and the remote
# panel. Any string; it must be IDENTICAL on both boards. A missing value
# fails the build rather than silently leaving the link unencrypted --
# without it, anything in radio range could send a setpoint command.
espnow_key: "change-me-to-something-random"
